rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validListing(data) {
      return data.title is string && data.title.size() > 2 && data.title.size() <= 90
        && data.description is string && data.description.size() <= 2000
        && data.category in ['Apartment', 'Student Housing', 'Vacation Rental']
        && data.status in ['Sale', 'Rent']
        && data.price is number && data.price > 0
        && data.bedrooms is int && data.bedrooms >= 0 && data.bedrooms <= 20
        && data.washrooms is int && data.washrooms >= 0 && data.washrooms <= 20
        && data.area is number && data.area > 0
        && data.location is string && data.location.size() > 1
        && data.facilities is list && data.facilities.size() <= 20
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 10;
    }

    // Public listings posted by signed-in users. Anyone can browse; only the owner can change them.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validListing(request.resource.data);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && validListing(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Each user's saved homes are private to them.
    match /users/{uid}/favorites/{favoriteId} {
      allow read, write: if isOwner(uid);
    }

    // Tour requests are visible to the requester and the listing owner.
    match /tourRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.date is string;
      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      // The listing owner may only move a request between pending / confirmed / declined.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'confirmed', 'declined'];
      allow delete: if signedIn() && resource.data.requesterId == request.auth.uid;
    }
  }
}
