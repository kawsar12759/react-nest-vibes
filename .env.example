# Firebase web app config (Project settings → Your apps)
VITE_APIKEY=
VITE_AUTHDOMAIN=
VITE_PROJECTID=
VITE_STORAGEBUCKET=
VITE_MESSAGINGSENDERID=
VITE_APPID=

# Cloudinary — exposed to the browser. The preset is unsigned, image-only and capped at 8 MB.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=nest_vibes_unsigned

# Cloudinary admin credentials — NOT prefixed with VITE_, so never bundled.
# Only used by `npm run setup:cloudinary` and `npm run migrate:images`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
